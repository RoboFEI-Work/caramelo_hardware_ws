<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="mecanum_wheel.xacro"/>
    <xacro:include filename="lidar_sensor.xacro"/>
    <xacro:include filename="imu.urdf.xacro"/>
    

    <!-- Parametros especificos do robo Caramelo -->
    <xacro:property name="base_mass" value="22.0"/>
    <xacro:property name="base_height" value="0.105"/>
    <xacro:property name="base_width_vertical" value="0.550"/>
    <xacro:property name="base_depth_vertical" value="0.210"/>
    <xacro:property name="base_width_horizontal" value="0.330"/>
    <xacro:property name="base_depth_horizontal" value="0.320"/>

    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width" value="0.069"/>
    <xacro:property name="wheel_mass" value="3.0"/>
    <xacro:property name="wheel_separation" value="0.310"/>
    <xacro:property name="wheel_base" value="0.470"/>
    <xacro:property name="front_wheel_x" value="0.182"/>
    <xacro:property name="back_wheel_x" value="-0.290"/>
    <xacro:property name="left_wheel_y" value="0.145"/>
    <xacro:property name="right_wheel_y" value="-0.145"/>
    <xacro:property name="wheel_z" value="0.034"/>
    <xacro:property name="base_mesh_xyz" value="-0.011611 -0.243518 -0.08"/>
    <xacro:property name="base_mesh_rpy" value="0 0 ${M_PI/2}"/>
    <xacro:property name="lidar_x" value="0.265"/>
    <xacro:property name="lidar_y" value="0.000"/>
    <xacro:property name="lidar_z" value="${base_height + 0.05 - 0.125}"/>
    <xacro:property name="lidar_rpy" value="${M_PI} 0 ${M_PI}"/>
    <xacro:property name="imu_x" value="-0.035"/>
    <xacro:property name="imu_y" value="0.000"/>
    <xacro:property name="imu_z" value="${base_height + 0.05 - 0.065}"/>
    <xacro:property name="imu_rpy" value="0 0 0"/>

    <!-- Base completa: footprint + base_link + 4 rodas mecanum -->
    <xacro:macro name="mobile_base" params="prefix">
    <link name="${prefix}base_footprint"/>

    <link name="${prefix}base_link">
        <!-- Corpo principal do robo -->
        <visual>
            <origin xyz="${base_mesh_xyz}" rpy="${base_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://caramelo_description/urdf/meshes/montagem_robo_final.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="darkgray"/>
        </visual>

        <!-- Colisao do corpo principal -->
        <collision>
            <origin xyz="${base_mesh_xyz}" rpy="${base_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://caramelo_description/urdf/meshes/montagem_robo_final.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <!-- Inercia aproximada por caixa envolvente da base -->
        <xacro:box_inertia
            m="${base_mass}"
            x="${base_width_vertical}"
            y="${base_width_horizontal}"
            z="${base_height}"
            o_xyz="0 0 ${base_height/2.0}"
            o_rpy="0 0 0"/>

    </link>

    <!-- Base apoiada nas rodas -->
    <joint name="${prefix}base_joint" type="fixed">
        <parent link="${prefix}base_footprint"/>
        <child link="${prefix}base_link"/>
        <origin xyz="0 0 ${wheel_radius - 0.02}" rpy="0 0 0"/>
    </joint>

    <!-- Quatro rodas mecanum -->
    <xacro:mecanum_wheel 
        prefix="${prefix}" 
        side="front_left" 
        wheel_xyz="${front_wheel_x} ${left_wheel_y} ${wheel_z}"/>

    <xacro:mecanum_wheel 
        prefix="${prefix}" 
        side="front_right" 
        wheel_xyz="${front_wheel_x} ${right_wheel_y} ${wheel_z}"
        wheel_rpy="${-M_PI/2} 0 0"/>
        

    <xacro:mecanum_wheel 
        prefix="${prefix}" 
        side="back_left" 
        wheel_xyz="${back_wheel_x} ${left_wheel_y} ${wheel_z}"
        wheel_rpy="${-M_PI/2} 0 0"/>

    <xacro:mecanum_wheel 
        prefix="${prefix}" 
        side="back_right" 
        wheel_xyz="${back_wheel_x} ${right_wheel_y} ${wheel_z}"/>

    <!-- Lidar no bico, preso direto na base -->
    <xacro:lidar_sensor
        prefix="${prefix}"
        parent="${prefix}base_link"
        frame_id="laser_frame"
        xyz_offset="${lidar_x} ${lidar_y} ${lidar_z}"
        rpy_offset="${lidar_rpy}"/>

    <!-- IMU presa direto na base -->
    <xacro:imu_sensor
        prefix="${prefix}"
        parent="${prefix}base_link"
        frame_id="imu"
        xyz_offset="${imu_x} ${imu_y} ${imu_z}"
        rpy_offset="${imu_rpy}"/>

    

  </xacro:macro>

</robot>
