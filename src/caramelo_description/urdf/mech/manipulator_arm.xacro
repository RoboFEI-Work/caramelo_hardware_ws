<?xml version="1.0"?>
<robot name="manip" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="../sensors/rgbd_camera.urdf.xacro"/>

  <xacro:macro name="manip_arm" params="
    base_link_name:='base_link'
    use_realsense:=true
    visual_mode:='package'
    mesh_uri_prefix:='package://caramelo_description'">

  <!-- ================= BASE ================= -->

  <link name="${base_link_name}">
    <visual>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <cylinder radius="0.065" length="0.055"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/base_link.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <collision>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <cylinder radius="0.065" length="0.055"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/base_link.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-05" ixy="0" ixz="0"
               iyy="1e-05" iyz="0"
               izz="1e-05"/>
    </inertial>
  </link>

  <!-- ================= LINK1 - FOGUETE ================= -->

  <link name="link1">

    <visual>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <cylinder radius="0.045" length="0.100"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link1.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <cylinder radius="0.045" length="0.100"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link1.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0"
               izz="0.0001"/>
    </inertial>

  </link>

  <!-- ================= LINK2 - (numero 01)================= -->

  <link name="link2">

    <visual>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <box size="0.055 0.055 0.185"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link2.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.09775" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <box size="0.055 0.055 0.185"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link2.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.09775" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 -0.09775" rpy="0 0 0"/>
      <inertia ixx="0.0004" ixy="0" ixz="0"
               iyy="0.0004" iyz="0"
               izz="0.00008"/>
    </inertial>

  </link>

  <!-- ================= LINK3 ================= -->

  <link name="link3">

    <visual>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <box size="0.050 0.050 0.205"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link3.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.28275" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <box size="0.050 0.050 0.205"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link3.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.28275" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 -0.28275" rpy="0 0 0"/>
      <inertia ixx="0.0004" ixy="0" ixz="0"
               iyy="0.0004" iyz="0"
               izz="0.00008"/>
    </inertial>

  </link>

  <!-- ================= LINK4 ================= -->

  <link name="link4">

    <visual>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <box size="0.050 0.050 0.160"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link4.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.48775" rpy="0 0 3.14"/>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <box size="0.050 0.050 0.160"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link4.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.48775" rpy="0 0 3.14"/>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.48775" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0"
               izz="0.00006"/>
    </inertial>

  </link>

  <!-- ================= FLANGE ================= -->

  <link name="link5">

    <visual>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <cylinder radius="0.035" length="0.080"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link5.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.5659" rpy="0.0 0 0"/>
      <material name="cyan">
        <color rgba="0 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <xacro:if value="${visual_mode == 'primitive'}">
          <cylinder radius="0.035" length="0.080"/>
        </xacro:if>
        <xacro:if value="${visual_mode != 'primitive'}">
          <mesh filename="${mesh_uri_prefix}/meshes/manipulator/link5.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
      </geometry>
      <origin xyz="0 0 -0.5659" rpy="0.0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 -0.5659" rpy="0.0 0 0"/>
      <inertia ixx="7.9e-05" ixy="0" ixz="0"
               iyy="1.9e-04" iyz="0"
               izz="2.68e-04"/>
    </inertial>

  </link>

  <!-- ================= REALSENSE D455 ================= -->

  <xacro:if value="${use_realsense}">
    <xacro:rgbd_camera
        parent="link5"
        camera_name="camera"
        use_nominal_extrinsics="true"
        visual_mode="${visual_mode}"
        mesh_uri_prefix="${mesh_uri_prefix}"
        xyz_offset="0 -0.055 0.0125"
        rpy_offset="0 -1.57079632679 -1.57079632679"/>
  </xacro:if>

  <!-- ================= ARM JOINTS ================= -->

  <joint name="manip_joint1" type="revolute">
    <parent link="${base_link_name}"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="10" velocity="1"/>
  </joint>

  <joint name="manip_joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.09775"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8"
           effort="10" velocity="3"/>
  </joint>

  <joint name="manip_joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.185"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6"
           effort="10" velocity="1"/>
  </joint>

  <joint name="manip_joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.205"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2"
           effort="10" velocity="1"/>
  </joint>

  <joint name="manip_joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="-0.03 0 0.07815"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="10" velocity="1"/>
  </joint>

  <!-- ================= TCP ================= -->

  <link name="tcp">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-08" ixy="0" ixz="0"
               iyy="1e-08" iyz="0"
               izz="1e-08"/>
    </inertial>
  </link>

  <joint name="tcp_fixed" type="fixed">
    <parent link="link5"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
  </joint>

  <!-- ==================== TCP 2 ==================-->

    <link name="tcp2">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-08" ixy="0" ixz="0"
               iyy="1e-08" iyz="0"
               izz="1e-08"/>
    </inertial>
  </link>

  <joint name="tcp2_fixed" type="fixed">
    <parent link="link5"/>
    <child link="tcp2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>

  </xacro:macro>

</robot>
