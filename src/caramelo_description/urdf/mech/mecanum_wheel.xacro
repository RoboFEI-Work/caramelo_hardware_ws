<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Macro de uma roda mecanum -->
    <xacro:macro name="mecanum_wheel" params="prefix side wheel_xyz wheel_rpy:='${M_PI/2} 0 0'">
        <link name="${prefix}${side}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="${wheel_rpy}"/>
                <geometry>
                    <mesh filename="package://caramelo_description/urdf/meshes/roda_escala_final.stl" scale="0.001 0.001 0.001"/>
                    <!--<cylinder radius="${wheel_radius}" length="${wheel_width}"/>-->
                </geometry>
                <material name="orange"/>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${wheel_rpy}"/>
                <geometry>
                    <mesh filename="package://caramelo_description/urdf/meshes/roda_escala_final.stl" scale="0.001 0.001 0.001"/> 
                    <!--<cylinder radius="${wheel_radius}" length="${wheel_width}"/>-->
                </geometry>
            </collision>

            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}" o_xyz="0 0 0" o_rpy="${M_PI/2} 0 0"/>

        </link>

        <!-- Rotacao continua da roda no eixo Y -->
        <joint name="${prefix}${side}_wheel_joint" type="continuous">
            <axis xyz="0 1 0"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}${side}_wheel_link"/>
            <origin xyz="${wheel_xyz}" rpy="0 0 0"/>
        </joint>
        
    </xacro:macro>
</robot>
