<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="mecanum_wheel_mesh" value="package://caramelo_description/meshes/robot_3d/roda_escala_final.stl"/>
    <xacro:property name="mecanum_wheel_mesh_scale" value="0.001 0.001 0.001"/>

    <!-- ROS2_CONTROL: os nomes das juntas sao contrato com caramelo_controllers.yaml e mobile_base_hw_interface.cpp. -->
    <xacro:macro name="mecanum_wheel" params="
        prefix
        side
        x_reflect
        y_reflect
        visual_mode:='package'
        wheel_mesh:='${mecanum_wheel_mesh}'
        wheel_mesh_scale:='${mecanum_wheel_mesh_scale}'">
        <link name="${prefix}${side}_wheel_link">
            <xacro:if value="${visual_mode == 'primitive'}">
                <visual>
                    <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                    </geometry>
                    <material name="orange"/>
                </visual>
            </xacro:if>
            <xacro:if value="${visual_mode != 'primitive'}">
                <visual>
                    <origin xyz="0 0 0" rpy="${M_PI/2 if x_reflect == y_reflect else -M_PI/2} 0 0"/>
                    <geometry>
                        <mesh filename="${wheel_mesh}" scale="${wheel_mesh_scale}"/>
                    </geometry>
                    <material name="orange"/>
                </visual>
            </xacro:if>

            <!-- COLISAO SEMPRE CILINDRO, mesmo quando o visual usa a malha.
                 A roda mecanum se comporta como um cilindro (os roletes cobrem
                 a circunferencia) e a inercia logo abaixo JA e' a de um
                 cilindro das mesmas medidas — a malha aqui nao acrescenta
                 fidelidade nenhuma e custa caro: roda_escala_final.stl tem
                 13,3 MB (46% de todo o STL do robo) e entra 4 vezes. Quem
                 monta modelo de colisao a partir desta descricao pagava BVH de
                 4x ~250k triangulos, e o RViz criava a entidade de colisao de
                 cada roda mesmo com "Collision Enabled: false".
                 Era assim no caramelo_description antigo ("cilindro simples
                 para otimizacao de performance"); perdeu-se na recriacao do
                 pacote em 01/07/2026. Restaurado em 10/09/2026. -->
            <collision>
                <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}" o_xyz="0 0 0" o_rpy="${M_PI/2} 0 0"/>

        </link>

        <!-- FRAME_CRITICO: rotacao continua da roda no eixo Y. -->
        <joint name="${prefix}${side}_wheel_joint" type="continuous">
            <axis xyz="0 1 0"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}${side}_wheel_link"/>
            <origin xyz="${wheel_center_x + x_reflect*(wheel_base/2)} ${y_reflect*(wheel_separation/2)} ${wheel_z}" rpy="0 0 0"/>
        </joint>
        
    </xacro:macro>
</robot>
